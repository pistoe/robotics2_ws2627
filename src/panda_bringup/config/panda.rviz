Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
    Background Color: 40; 45; 50
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Cell Size: 0.1
    - Class: rviz_default_plugins/RobotModel
      Name: Panda
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /panda/robot_description
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Robot Description: robot_description
      Planning Scene Topic: /panda/monitored_planning_scene
      Move Group Namespace: /panda
      Planning Request:
        Planning Group: panda_arm
        Interactive Marker Size: 0.15
        Query Goal State: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point: {X: 0.3, Y: 0.0, Z: 0.45}
      Pitch: 0.4
      Yaw: 0.8
Window Geometry:
  Width: 1100
  Height: 800
