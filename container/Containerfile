# heredocs can apparently not be parsed with buildah as distributed under ubuntu 24.04.
# https://github.com/podman-container-tools/buildah/issues/5474


COPY container/check_versions.py /tmp/check_versions.py
RUN python /tmp/check_versions.py




RUN dpkg-query -W > /opt/panda/packages.lock && install -d -m 1777 /data
WORKDIR /workspaces/student
ENTRYPOINT ["/opt/panda/entrypoint.sh"]
CMD ["ros2", "launch", "panda_bringup", "simulation.launch.py"]
